# template, option docs: applied when WITH_DOCS is set and not 0, no, false or off (the recipe
# defaults it to 1). A valued option is a directory named <name>=<value>, applied when <value>
# is one of the words of WITH_<NAME> (option/ssl=mbedtls).
PKG_DEPS+=" lfs/doxygen:native"
CONF_FLAGS+=" --enable-docs"
