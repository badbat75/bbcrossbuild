# template, target cross: applied after ../../../package.env when the package is built with
# ":cross" (into the platform toolchain). Assignments replace (=) or extend (+=) the values of
# package.env; a prebuild.sh, postbuild.sh, build.sh or postinstall.sh in this directory replaces
# the one of the recipe for this target, a patches/ directory here is searched before patches/.
CONF_FLAGS+=" --disable-docs"
