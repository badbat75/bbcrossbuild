#linux-firmware
PKG_VER=20241210
### git.kernel.org no longer serves cgit snapshots ("Unsupported snapshot format"); use the release tarball
PKG_URL="https://cdn.kernel.org/pub/linux/kernel/firmware/linux-firmware-${PKG_VER}.tar.xz"
PKG_DEPS=lfs/rdfind:cross
BUILD_PROCESS=simplemake
PKG_MAKETARGETS="install"
