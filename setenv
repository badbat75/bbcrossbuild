# setenv: every path and version default, computed from what bbxb.conf and the platform set.
# Sourced by bbxb (and by utilities/pkgtools.functions): the variables are read by the libraries.
# shellcheck shell=bash disable=SC2034
NPROCS=$(nproc --ignore=1)
LTOPROCS=$(( $(nproc) / 4 ))

# C standard for everything compiled with the host compiler (native builds, *_FOR_BUILD flags,
# toolchain bootstrap). GCC 15 and later default to C23, where "int f ()" is a prototype with no
# arguments, and several GNU packages built for the host (gettext, gmp...) still rely on the old
# meaning. Override from bbxb.conf when the host compiler needs something else.
HOST_CSTD=${HOST_CSTD:--std=gnu17}
# Same for the C++ sources of the toolchain bootstrap (binutils, gcc), empty by default: the
# gcc 16 sources build with the C++20 default of the host gcc 16, while any -std here breaks
# its configure (top level wants at least C++14, libcody exactly C++11 and it can only add its
# own -std=c++11 when CXXFLAGS carries none). Set -std=gnu++11 for gcc 14 sources.
HOST_CXXSTD=${HOST_CXXSTD:-}

HARCH=${HM}-${HOS}-${HLIBC}

DATA_PATH=${DATA_PATH:-/mnt/bbcrossbuild/datadir}

GLOBAL_SRC_PATH=${DATA_PATH}/${SRC_DIR:-sources}
GLOBAL_BLD_PATH=${DATA_PATH}/${BLD_DIR:-builds}
GLOBAL_LOG_PATH=${DATA_PATH}/${LOG_DIR:-logs}
GLOBAL_TOOLCHAIN_PATH=${DATA_PATH}/${TOOLCHAIN_DIR:-toolchain}
GLOBAL_CACHE_PATH=${DATA_PATH}/${CACHE_DIR:-cache}
DOWNLOAD_PATH=${DATA_PATH}/${DOWNLOAD_DIR:-downloads}
export GLOBAL_TOOLCHAIN_PATH

PROJECT_PATH=${DATA_PATH}/${PROJECT_NAME}
PLATFORM_PATH=${PROJECT_PATH}/${PLATFORM_NAME}
DISTOS_PATH=${PLATFORM_PATH}/${DISTOS_DIR:-distos}
SRC_PATH=${PROJECT_PATH}/${SRC_DIR:-sources}
BLD_PATH=${PLATFORM_PATH}/${BLD_DIR:-builds}
