#!/bin/bash
trap 'STATUS=${?}; \
	echo >&2; \
	echo "[${FUNCNAME[*]} - ERR: ${STATUS}]" >&2; \
	echo >&2; \
	set +E +o pipefail; \
	trap - ERR SIGINT; \
	exit ${STATUS}' ERR

set -E -o pipefail

BB_HOME=$(realpath "$(dirname "${BASH_SOURCE[0]}")")
#PROGRAM_NAME="$(basename "${BASH_SOURCE[0]}")"

# shellcheck source=/dev/null
source "${BB_HOME}/seterr"
# shellcheck source=/dev/null
source "${BB_HOME}/core.functions"
check_core_functions
# shellcheck source=/dev/null
source "${BB_HOME}/container.functions"

### Inside the container bbxb starts as root, whoever started the container: it creates the user
### the build runs for (CONTAINER_USER, set by container_run on the host) and runs this command
### line again as that user, so the data directory keeps the owners it has on the host
if [ -n "${BBXB_IN_CONTAINER}" ] && [ "${EUID}" -eq 0 ] && [ -n "${CONTAINER_USER}" ]
then
	container_user "${@}"
fi

function bbxb_usage () {
	### bbxb_usage: the help of bbxb, with the projects and the platforms of the checkout
	local NAMES
	cat <<-EOF
		Usage: bbxb [--container|--no-container] <command> <project> <platform>
		       bbxb container <command> [<argument>...]

		Commands:
		  build <project> <platform>     build the project for the platform
		  logtail <project> <platform>   follow the logs of the project on the platform, the new ones
		                                 included (Ctrl-C to stop): the native, cross and target builds
		  mount [--ro] <project> <platform> [<directory>]
		                                 mount the image of the project (<platform>/<project>.img) on
		                                 <directory> (default: <project>.mnt next to it): the partition
		                                 with /etc/fstab is the root, the others go where its fstab says
		  mount [--ro] <image> [<directory>]
		                                 the same for any disk image (default: <image>.mnt)
		  mount list                     the images mounted, by bbxb mount or by a build
		  umount <project> <platform> | <image> | <directory>
		                                 unmount an image and detach its loop device
		  container <command>            the image and the containers of bbxb (bbxb container help)
		  help                           this help

		Options:
		  --container      build in the container of this checkout (CONTAINER_BUILD=1 in bbxb.conf)
		  --no-container   build on the host

	EOF
	NAMES=$(find "${BB_HOME}/${PRJ_PATH:-projects}" -maxdepth 1 -name '*.prj' -printf '%f\n' 2> /dev/null | sed 's/\.prj$//' | sort | xargs)
	echo "Projects:  ${NAMES:-none} (${PRJ_PATH:-projects}/<project>.prj)"
	NAMES=$(find "${BB_HOME}/${PLATFORM_DIR:-platforms}" -maxdepth 1 -name '*.conf' -printf '%f\n' 2> /dev/null | sed 's/\.conf$//' | sort | xargs)
	echo "Platforms: ${NAMES:-none} (${PLATFORM_DIR:-platforms}/<platform>.conf)"
}

function bbxb_done () {
	### bbxb_done [<status>]: leave without the handlers of an error
	set +E +o pipefail
	trap - ERR SIGINT
	rm -f "${TMPDIR:-/tmp}/bbxb_error.${$}" "${BUILD_CHECKED_FILE}"
	exit "${1:-0}"
}

### From here on the handlers of core.functions: one report from the innermost shell, the
### images unmounted by the main shell only (unmount_tag is looked up when the error happens)
rm -f "${TMPDIR:-/tmp}/bbxb_error.${$}"
### The packages build has built or found built in this run (build.functions): a restarted container
### can give the new run the pid of the old one
BUILD_CHECKED_FILE="${TMPDIR:-/tmp}/bbxb_checked.${$}"
rm -f "${BUILD_CHECKED_FILE}"
# shellcheck disable=SC2034
exec {BBXB_CONSOLE_FD}>&2
trap 'on_error ${?}' ERR
trap 'on_interrupt' SIGINT

### bbxb container <command>: the image and the containers of bbxb on this host (container_command),
### with the settings of bbxb.conf (CONTAINER_REGISTRY) and nothing of a project or a platform
if [ "${1}" == container ]
then
	shift
	if [ -f "${BB_HOME}/bbxb.conf" ]
	then
		# shellcheck source=/dev/null
		source "${BB_HOME}/bbxb.conf"
	fi
	container_command "${@}"
	bbxb_done
fi

### No argument, or no project and no platform after the command: the help, not an error
if [ ${#} -eq 0 ] || [[ ${1} == @(help|-h|--help) ]] || { [[ ${1} == @(build|logtail|mount|umount) ]] && [ ${#} -eq 1 ]; }
then
	bbxb_usage
	bbxb_done
fi

### bbxb mount|umount of an image file or a directory, and bbxb mount list: nothing of a project or a
### platform. With a project and a platform they go on below, where setenv gives the image its path
if [[ ${1} == @(mount|umount) ]]
then
	OPTS="--ro" OPTS_WITH_VALUE="" param2value "${@:2}"
	# shellcheck disable=SC2154
	MOUNT_ARGS=("${_param_1}" "${_param_2}" "${_param_3}")
	MOUNT_RO=${_param_ro:+--ro}
	if [ "${1}" == mount ] && [ "${MOUNT_ARGS[0]}" == list ] && [ -z "${MOUNT_ARGS[1]}" ]
	then
		# shellcheck source=/dev/null
		source "${BB_HOME}/images.functions"
		image_mount_list
		bbxb_done
	fi
	if [ -e "${MOUNT_ARGS[0]}" ] && [ -z "${MOUNT_ARGS[2]}" ]
	then
		# shellcheck source=/dev/null
		source "${BB_HOME}/images.functions"
		if [ "${1}" == mount ]
		then
			# shellcheck disable=SC2086
			image_mount ${MOUNT_RO} "${MOUNT_ARGS[0]}" ${MOUNT_ARGS[1]:+"${MOUNT_ARGS[1]}"}
		else
			image_umount "${MOUNT_ARGS[0]}"
		fi
		bbxb_done
	fi
fi

OPTS="--container --no-container --ro" OPTS_WITH_VALUE="" param2value "${@}"

### bbxb [--container|--no-container] <command> <project> <platform>: build runs the project file,
### logtail follows the logs of the project on the platform (the native, cross and target builds,
### the new ones as they appear) while a build runs, from another terminal
# shellcheck disable=SC2154
BBXB_COMMAND="${_param_1}"
# shellcheck disable=SC2154
PROJECT_NAME="${_param_2}"
# shellcheck disable=SC2154
PLATFORM_NAME="${_param_3}"

### mount: the directory after the platform, --ro (only for mount)
# shellcheck disable=SC2154
MOUNT_DIR=${_param_4}
if [ -n "${_param_ro}" ] && [ "${BBXB_COMMAND}" != mount ]
then
	trow_error "${ERROR_NOT_VALID_OPTION}" "--ro is an option of mount (bbxb help)."
fi

case "${BBXB_COMMAND}" in
	build|logtail|mount|umount)
		;;
	*)
		trow_error "${ERROR_NOT_VALID_OPTION}" "Unknown command ${BBXB_COMMAND} (bbxb help)."
		;;
esac

if [ -z "${PROJECT_NAME}" ]
then
	trow_error "${ERROR_NOT_VALID_OPTION}" "No project name specified (bbxb help)."
fi

if [ -z "${PLATFORM_NAME}" ]
then
	trow_error "${ERROR_NOT_VALID_OPTION}" "No platform name specified (bbxb help)."
fi

ulimit -n 2048
umask 0022

if [ -f "${BB_HOME}/bbxb.conf" ]
then
	# shellcheck source=/dev/null
	source "${BB_HOME}/bbxb.conf"
fi

PROJECT=${BB_HOME}/${PRJ_PATH:-projects}/${PROJECT_NAME}.prj
PLATFORM=${BB_HOME}/${PLATFORM_DIR:-platforms}/${PLATFORM_NAME}.conf

if [ ! -f "${PLATFORM}" ]
then
	trow_error "${ERROR_FILE_NOT_FOUND}" "Platform ${PLATFORM} does not exist."
fi

# shellcheck source=/dev/null
source "${PLATFORM}"
# shellcheck source=/dev/null
source "${BB_HOME}/setenv"

### The settings of the project: the user file next to its .prj (gitignored), sourced here so that
### everything below, the parameters printed included, already has the values the build uses
PROJECT_CONF=${PRJ_PATH}/${PROJECT_NAME}.conf
if [ -f "${PROJECT_CONF}" ]
then
	# shellcheck source=/dev/null
	source "${PROJECT_CONF}"
fi

### The logs of the project: the platform ones (every package build, native and cross included)
### and the global ones of the native toolchain steps. On the host, container build or not: the
### data directory is the same
if [ "${BBXB_COMMAND}" = logtail ]
then
	echo "Following the logs of ${LOG_PATH} and ${GLOBAL_LOG_PATH} (Ctrl-C to stop)"
	log_tail "${LOG_PATH}" "${GLOBAL_LOG_PATH}"
fi

### The image of the project, where unmount_tag --finalize leaves it
if [[ ${BBXB_COMMAND} == @(mount|umount) ]]
then
	# shellcheck source=/dev/null
	source "${BB_HOME}/images.functions"
	if [ ! -f "${PLATFORM_PATH}/${PROJECT_NAME}.img" ]
	then
		trow_error "${ERROR_FILE_NOT_FOUND}" "${PROJECT_NAME} ${PLATFORM_NAME} has no image ${PLATFORM_PATH}/${PROJECT_NAME}.img."
	fi
	if [ "${BBXB_COMMAND}" == mount ]
	then
		# shellcheck disable=SC2086
		image_mount ${MOUNT_RO} "${PLATFORM_PATH}/${PROJECT_NAME}.img" ${MOUNT_DIR:+"${MOUNT_DIR}"}
	else
		image_umount "${PLATFORM_PATH}/${PROJECT_NAME}.img"
	fi
	bbxb_done
fi

### The package groups are git submodules: an empty packages/<group> is a checkout without them
for PKG_GROUP in "${PKG_PATH}"/*/
do
	if [ -z "$(ls -A "${PKG_GROUP}")" ]
	then
		trow_error "${ERROR_FILE_NOT_FOUND}" "${PKG_GROUP} is empty: run 'git submodule update --init' in ${BB_HOME}."
	fi
done
unset PKG_GROUP

### --container (CONTAINER_BUILD of bbxb.conf, --no-container to turn it off): the same command
### line runs inside the container of this checkout, which is built first when it is missing.
### Inside it BBXB_IN_CONTAINER is set and the build runs here, as on the host
# shellcheck disable=SC2154
if [ -n "${_param_container}" ]
then
	CONTAINER_BUILD=1
fi
# shellcheck disable=SC2154
if [ -n "${_param_no_container}" ]
then
	CONTAINER_BUILD=0
fi
if [ "${CONTAINER_BUILD:-0}" -eq 1 ] && [ -z "${BBXB_IN_CONTAINER}" ]
then
	container_run "${@}"
fi

# shellcheck source=/dev/null
source "${BB_HOME}/build.functions"
# shellcheck source=/dev/null
source "${BB_HOME}/project.functions"
# shellcheck source=/dev/null
source "${BB_HOME}/toolchain.functions"
# shellcheck source=/dev/null
source "${BB_HOME}/images.functions"
# shellcheck source=/dev/null
source "${BB_HOME}/data.functions"
# shellcheck source=/dev/null
source "${BB_HOME}/osconfig.functions"

if [ ! -f "${PROJECT}" ]
then
	trow_error "${ERROR_FILE_NOT_FOUND}" "Project ${PROJECT} does not exist."
fi

echo
echo "Core parameters:"
echo "================"
echo "Project path: ${DATA_PATH}/${PROJECT_NAME}"
echo "Toolchain: ${TOOLCHAIN}"
echo "Packages Optimization Level: ${OPTLEVEL:-2}"
echo "Packages LTO Enabled: ${LTOENABLE:-off}"
echo "Kernel Optimization Level: ${KERNEL_OPTLEVEL:-2}"
echo "Kernel LTO Enabled: ${KERNEL_LTOENABLE:-off}"
echo "Verbose build: ${MAKEVERBOSE:-0}"
echo

if [ ! -d "${GLOBAL_LOG_PATH}" ]
then
	mkdir -p "${GLOBAL_LOG_PATH}"
fi

if [ ! -d "${LOG_PATH}" ]
then
	mkdir -p "${LOG_PATH}"
fi

if [ ! -d "${USERDATA_PATH}" ]
then
	mkdir -p "${USERDATA_PATH}"
fi

# shellcheck source=/dev/null
source "${PROJECT}"

unmount_tag --all

echo -e "Build completed!\n"

bbxb_done