#!/bin/bash

check_core_functions () {
	is_core_functions 2>/dev/null
	if [ ! ${?} ]
	then
		echo "Core functions not loaded"
		exit 1
	fi
}

param2value () {
	
	# Requires at least one OPTS or OPTS_WITH_VALUE to run
	# OPTS="-a -b -c" OPTS_WITH_VALUE="-d" param2value "${@}"

	local NUM OPTION OPTS PARAMETER

	OPTS+=" -v "
	NUM=0

	# shellcheck disable=SC2046
	unset $( ( set -o posix ; set ) | ( grep ^_param_ || : ) | sed 's/=.*$//g' | xargs )

	while(($#)) ; do
		if [[ ${1} == -* ]]
		then
			if [ "${1} " == "$(echo "${OPTS} ${OPTS_WITH_VALUE} " | grep -o -- "${1} ")" ]
				then
					OPTION=${1}
					PARAMETER=$(echo "${1}" | sed -e 's/^--\?//;s/-/_/g')
					if [ "${1} " == "$(echo "${OPTS_WITH_VALUE} " | grep -o -- "${1} ")" ]
					then
						shift
						if [ ! "${1}" == "" ]
						then 
							eval "_param_${PARAMETER}='${1}'"
						else
							trow_error "${ERROR_NOT_VALID_OPTION}" "${OPTION} unset, no assigned value."
						fi
					else
						eval "_param_${PARAMETER}=1"
					fi
			else
				trow_error "${ERROR_NOT_VALID_OPTION}" "Unrecognized option: ${1}"
			fi
		else
				NUM=$((NUM+1))
				eval "_param_${NUM}='${1}'"
				PARAMETER=${NUM}
		fi
		if [ "${_param_v:-0}" -eq 1 ]
		then
			eval echo "_param_${PARAMETER}=\$_param_${PARAMETER}"
		fi
		shift
	done
}

download_uncompress () {
	## download_uncompress <URLs> <destination> [files_to_extract]
	## STRIPCOMPONENTS=<num>: Add strip --strip-components=<n> to tar command
	## ARCHIVEDIRS=<str>: Specify what directories to extract
	## NODELETEDESTDIR=<num>: if 1 don't delete ${DEST_DIR}

	local URL \
		URL_HASH \
		DEST_DIR \
		FILES2EXTRACT \
		STRIPCOMPONENTS \
		NODELETEDESTDIR \
		TARFLAGS \
		HASH_ROW \
		DOWNLOAD_FILE \
		DOWNLOAD_HASH_FILE \
		FILE_ENCODING \
		DOWNLOAD_FILE_TYPE \
		UNCOMPRESSED_FILE_TYPE

	echo "download_uncompress ${*}" | log_buffer

	URL=${1}
	URL_HASH=$(echo -n "${URL}" | md5sum -t | awk '{print $1}')
	DEST_DIR=${2}
	if shift 2 
	then
		FILES2EXTRACT="${*}"
	else
		FILES2EXTRACT=
	fi
	STRIPCOMPONENTS=${STRIPCOMPONENTS:-1}
	NODELETEDESTDIR=${NODELETEDESTDIR:-0}
	if [ "${STRIPCOMPONENTS}" -gt 0 ]
	then
		TARFLAGS="--strip-components=${STRIPCOMPONENTS}"
	fi
	if [ ! -d "${DOWNLOAD_PATH}" ]
	then
		run_cmd "mkdir -pv \"${DOWNLOAD_PATH}\""
	fi
	if [ ! -f "${DOWNLOAD_PATH}/url2file.map" ]
	then
		run_cmd "touch \"${DOWNLOAD_PATH}/url2file.map\""
	fi
	HASH_ROW=$( if [ -f "${DOWNLOAD_PATH}/url2file.map" ]; then grep "${URL_HASH}" "${DOWNLOAD_PATH}/url2file.map" || true ; fi )
	# if download file does not exists in database download package
	if [ -z "${HASH_ROW}" ]
	then
		echo "\$ curl -k -vLsI -o /dev/null \"${URL}\"" | log_buffer info
		DOWNLOAD_FILE="$( curl -k -vLsI -o /dev/null "${URL}" 2>&1 | grep -E -i '^< content-disposition:.*filename=' | tr -d "\n\r" | sed -e 's/^.*filename="\?//;s/".*//' || true )"
		if [ -z "${DOWNLOAD_FILE}" ]
		then
			DOWNLOAD_FILE="$(basename "${URL}")"
		else
			DOWNLOAD_FILE="$(basename "${DOWNLOAD_FILE}")"
		fi
		DOWNLOAD_HASH_FILE="${URL_HASH}_$(basename "${DOWNLOAD_FILE}")"
		echo "${URL_HASH} ${DOWNLOAD_FILE}" >> "${DOWNLOAD_PATH}/url2file.map"
	else
	DOWNLOAD_HASH_FILE=$(echo "${HASH_ROW}" | awk '{print $1 "_" $2}')
	DOWNLOAD_FILE=$(echo "${HASH_ROW}" | awk '{print $2}')
	fi
	# if download file does not exists in filesystem
	if [ ! -f "${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}" ]
	then
		### -f: an HTTP error must stop the build here instead of storing the error page as the source archive
		run_cmd "curl -k -fLsR -o \"${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}\" \"${URL}\""
	fi
	if [ -d "${DEST_DIR}" ] && [ "${NODELETEDESTDIR}" -eq 0 ]
	then
		run_cmd "rm -rf ${DEST_DIR}"
	fi
	FILE_ENCODING=$(file -iz "${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}")
	DOWNLOAD_FILE_TYPE=$(echo "${FILE_ENCODING}" | grep -E -o "compressed-encoding=[^;]*" | sed 's/compressed-encoding=//' || true )
	UNCOMPRESSED_FILE_TYPE=$(echo "${FILE_ENCODING}" | awk '{print $2}' | sed 's/;$//')
	### A server that answers 200 with an HTML page (a moved repository, a landing page) must
	### not leave that page in the cache in place of the archive: drop it and fail here.
	if [ "${UNCOMPRESSED_FILE_TYPE}" = "text/html" ]
	then
		run_cmd "rm -f \"${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}\""
		trow_error "${ERROR_GENERIC}" "The download of ${URL} is an HTML page, not an archive"
	fi
	if [ ! -d "${DEST_DIR}" ] ; then run_cmd "mkdir -pv \"${DEST_DIR}\"" ; fi
	case ${UNCOMPRESSED_FILE_TYPE} in
		application/x-tar)
			run_cmd "tar xf \"${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}\" ${TARFLAGS} --no-same-owner -C \"${DEST_DIR}\" ${ARCHIVE_DIRS}"
			;;
		*)
			case ${DOWNLOAD_FILE_TYPE} in
				application/x-xz)
					run_cmd "cp \"${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}\" \"${DEST_DIR}/${DOWNLOAD_FILE}\""
					run_cmd "xz --uncompress \"${DEST_DIR}/${DOWNLOAD_FILE}\""
					;;
				application/zip)
					if [ -z "${FILES2EXTRACT}" ]
					then
						run_cmd "unzip -n \"${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}\" -d \"${DEST_DIR}\""
					else
						run_cmd "unzip -j -n \"${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}\" \"${FILES2EXTRACT}\" -d \"${DEST_DIR}\""
					fi
					;;
				*)
					run_cmd "cp \"${DOWNLOAD_PATH}/${DOWNLOAD_HASH_FILE}\" \"${DEST_DIR}/${DOWNLOAD_FILE}\""
					;;
			esac
			;;
	esac
}

test_version () {
	test -z "${3}" && echo "I need 2 arguments to compare and an operator." && return 255

	local SORTED BIGGEST NO

	SORTED="$(echo -e "${1}\n${3}" | sort -Vru -)"
	BIGGEST="$(echo -e "${SORTED}" | head -n1)"
	NO="$(echo -e "${SORTED}" | wc -l)"

	case ${2} in
		-gt)
			if [ "${BIGGEST}" == "${1}" ] && [ "${NO}" -gt 1 ]
			then
					return 0
			else
					return 1
			fi
		;;
		-ge)
			if [ "${BIGGEST}" == "${1}" ]
			then
					return 0
			else
					return 1
			fi
		;;
		-lt)
			if [ "${BIGGEST}" != "${1}" ] && [ "${NO}" -gt 1 ]
			then
					return 0
			else
					return 1
			fi
		;;
		-le)
			if [ "${BIGGEST}" != "${1}" ] || [ "${NO}" -eq 1 ]
			then
					return 0
			else
					return 1
			fi
		;;
		-eq)
			if [ "${NO}" -eq 1 ]
			then
					return 0
			else
					return 1
			fi
		;;
		-ne)
			if [ "${NO}" -eq 2 ]
			then
					return 0
			else
					return 1
			fi
		;;
		*)
			trow_error "${ERROR_NOT_VALID_OPTION}" "No valid operator specified!"
		;;
	esac	
}

pause () {
	echo
	read -n 1 -s -r -p "Press any key to continue..."
	echo
}

pathadd () {

	### pathadd <PATH|LD_LIBRARY_PATH> <path-name>

	if [ -z "${1}" ]
	then
		trow_error "${ERROR_NOT_VALID_OPTION}" "Variable not defined."
	fi

	if [ -z "${2}" ]
	then
		return 0
	fi

	eval "while read sp
		do
			if [ \"\${sp}\" == \"\${2}\" ]
			then
				return 0
			fi
		done < <(tr ':' '\n' <<< \"\${${1}}\")

		if [ -z \"\${${1}}\" ]
		then
			${1}=\"\${2}\"
		else
			${1}=\"\${2}:\${${1}}\"
		fi
		export ${1}"
}

pathremove () {

	### pathremove <PATH|LD_LIBRARY_PATH> <path-name>

	if [ -z "${1}" ]
	then
		trow_error "${ERROR_NOT_VALID_OPTION}" "Variable not defined."
	fi

	if [ -z "${2}" ]
	then
		trow_error "${ERROR_NOT_VALID_OPTION}" "Path not defined."
		echo "Path not defined."
	fi

	eval "local i FPATH FOUND
		i=1
		FPATH=
		FOUND=0

		while read sp
		do
			if [ \"\${sp}\" != \"\${2}\" ]
			then
				local FPATH+=\"\$( [ \$i -gt 1 ] && echo \":\" )\${sp}\"
				let \"i+=1\"
			else
				local FOUND=1
			fi
		done < <(tr ':' '\n' <<< \"\${${1}}\")

		if [ \${FOUND} -eq 1 ]
		then
			export ${1}=\"\${FPATH}\"
		fi"
}

log_buffer () {
	### log_buffer [log_type] [log_file]: prefix every line of stdin with time, directory and type.
	### No external command per line: the writer has to keep up with the output of a parallel make.
	(
		local LOG_TYPE="${1:-log}"
		local LOG_DEST="${2:-/dev/stdout}"
		local LOG_CHAR LOG_DIR LOG_LINE
		case ${LOG_TYPE} in
			cmd)    LOG_CHAR='$';;
			info)   LOG_CHAR='#';;
			log)    LOG_CHAR='-';;
			status) LOG_CHAR='=';;
			error)  LOG_CHAR='!';;
			*)      LOG_CHAR="${LOG_TYPE}";;
		esac
		LOG_DIR=${PWD##*/}
		while IFS= read -r LOG_LINE || [ -n "${LOG_LINE}" ]
		do
			printf '%(%Y-%m-%d %H:%M:%S)T - [%s]%s %s\n' -1 "${LOG_DIR:-/}" "${LOG_CHAR}" "${LOG_LINE}"
		done >> "${LOG_DEST}"
	)
}

log_wait () {
	### log_wait <pid>...: wait for the log writers started by log_run, LOG_WAIT_TIMEOUT seconds
	### at most (default 10): a command that leaves a daemon behind (the sccache server) keeps the
	### pipes open and its writers never end.
	local LOG_PID LOG_POLLS
	LOG_POLLS=$(( ${LOG_WAIT_TIMEOUT:-10} * 50 ))
	for LOG_PID in "${@}"
	do
		while [ "${LOG_POLLS}" -gt 0 ] && kill -0 "${LOG_PID}" 2> /dev/null
		do
			sleep 0.02
			LOG_POLLS=$((LOG_POLLS-1))
		done
	done
	return 0
}

log_run () {
	### log_run <log_file> <command> [<argument>...]: run the command (in this shell, so eval and
	### functions work) with stdout and stderr going through log_buffer into <log_file> (empty:
	### the current stdout) and return its status once both log writers are done. The log is
	### therefore complete when the caller, or the ERR trap, acts on a failure; a shell that
	### exits with the writers still behind loses the last lines, which are the error. The
	### command runs in a || list: a function passed here has to return its own status.
	local LOG_RUN_FILE LOG_RUN_STATUS LOG_RUN_OUT LOG_RUN_ERR LOG_RUN_OUTPID LOG_RUN_ERRPID LOG_RUN_SHELL
	LOG_RUN_FILE=${1:-/dev/stdout}
	shift
	exec {LOG_RUN_OUT}> >(log_buffer log "${LOG_RUN_FILE}")
	LOG_RUN_OUTPID=${!}
	exec {LOG_RUN_ERR}> >(log_buffer error "${LOG_RUN_FILE}")
	LOG_RUN_ERRPID=${!}
	LOG_RUN_STATUS=0
	ERROR_LOG=
	if [ -n "${BBXB_CONSOLE_FD}" ]
	then
		### The command does not inherit the console of error_console: a daemon would keep it open
		"${@}" 1>&"${LOG_RUN_OUT}" 2>&"${LOG_RUN_ERR}" {BBXB_CONSOLE_FD}>&- || LOG_RUN_STATUS=${?}
	else
		"${@}" 1>&"${LOG_RUN_OUT}" 2>&"${LOG_RUN_ERR}" || LOG_RUN_STATUS=${?}
	fi
	exec {LOG_RUN_OUT}>&- {LOG_RUN_ERR}>&-
	log_wait "${LOG_RUN_OUTPID}" "${LOG_RUN_ERRPID}"
	if [ "${LOG_RUN_STATUS}" -ne 0 ]
	then
		### Global on purpose: on_error reports the log of the command that failed
		if [ "${LOG_RUN_FILE}" == /dev/stdout ]
		then
			LOG_RUN_SHELL=${BASHPID}
			ERROR_LOG=$(stdout_log "${LOG_RUN_SHELL}")
		else
			ERROR_LOG=${LOG_RUN_FILE}
		fi
	fi
	return "${LOG_RUN_STATUS}"
}

stdout_log () {
	### stdout_log <pid of the calling shell>: print the file the stdout of that shell is
	### redirected to, when it is a regular file and not the stdout of the main shell as well
	### (bbxb itself redirected to a file is the console, not a log)
	local SHELL_OUT MAIN_OUT
	SHELL_OUT=$(readlink "/proc/${1}/fd/1" 2> /dev/null || true)
	MAIN_OUT=$(readlink "/proc/${$}/fd/1" 2> /dev/null || true)
	if [ -f "${SHELL_OUT}" ] && [ "${SHELL_OUT}" != "${MAIN_OUT}" ]
	then
		echo "${SHELL_OUT}"
	fi
	return 0
}

run_cmd () {
	### run_cmd [-S|-s] "command string": log the command and run it through log_run. The status
	### is returned, never trapped here: the ERR trap fires at the call site, once the log is
	### complete, and MAX_RETRIES can repeat the command.
	local CMDLINE STATUS RETRIES RUNCMD_SUDO LOG_TYPE LOG_LINE

	RUNCMD_SUDO=
	case "${1}" in
		"-S")
			RUNCMD_SUDO="sudo/bash"
			shift
			;;
		"-s")
			RUNCMD_SUDO="sudo"
			shift
			;;
	esac
	CMDLINE="${*}"
	STATUS=255
	RETRIES=0
	while [ "${STATUS}" -ne 0 ] && [ "${RETRIES}" -lt "${MAX_RETRIES:-1}" ]
	do
		RETRIES=$((RETRIES+1))
		if [ ${RETRIES} -gt 1 ]
		then
			# Sleep random between 6 and 10 seconds
			sleep $((6 + "${RANDOM}" % 5))
			echo "Try ${RETRIES}" | log_buffer info
		fi
		LOG_TYPE=cmd
		while IFS= read -r LOG_LINE
		do
			echo "${LOG_LINE}" | log_buffer "${LOG_TYPE}"
			LOG_TYPE='>'
		done <<< "${RUNCMD_SUDO:+[${RUNCMD_SUDO}] }${CMDLINE}"
		STATUS=0
		case "${RUNCMD_SUDO}" in
		"sudo/bash")
			log_run "" sudo bash -c "${CMDLINE}" || STATUS=${?}
			;;
		*)	log_run "" eval "${RUNCMD_SUDO:+${RUNCMD_SUDO} }${CMDLINE}" || STATUS=${?}
			;;
		esac
	done
	return "${STATUS}"
}

trow_error () {
	### trow_error <error_code> <error_message>: return the code; under bbxb the ERR trap
	### (on_error) reports the message, elsewhere (utilities, recipe scripts) it is printed here.
	local ERROR_CODE=${1}
	### Global on purpose: on_error reads it
	ERROR_MSG=${2}

	if [[ $(trap -p ERR) != *on_error* ]]
	then
		echo >&2
		echo "${ERROR_MSG:-ERR received.} [${FUNCNAME[*]} - ERR: ${ERROR_CODE}]" >&2
	fi
	return "${ERROR_CODE}"
}

error_console () {
	### error_console: print stdin on the console, the stderr bbxb started with, which it keeps
	### as BBXB_CONSOLE_FD: a failing step usually has its own stderr redirected to a log.
	if [ -n "${BBXB_CONSOLE_FD}" ] && { : >&"${BBXB_CONSOLE_FD}"; } 2> /dev/null
	then
		cat >&"${BBXB_CONSOLE_FD}"
	else
		cat >&2
	fi
	return 0
}

on_error () {
	### on_error <status>: the ERR trap of bbxb (trap 'on_error ${?}' ERR, with set -E). A failure
	### inside nested builds climbs one subshell at a time: the innermost shell reports it, once
	### (message, package, call stack, log file and its last lines), the parent shells only pass
	### the status on, and the main shell unmounts the images and exits.
	local STATUS=${1:-1}
	local ERROR_FLAG ERROR_SHELL
	set +E +o pipefail
	trap - ERR
	ERROR_FLAG="${TMPDIR:-/tmp}/bbxb_error.${$}"
	if [ "${STATUS}" -ne 130 ] && [ ! -f "${ERROR_FLAG}" ]
	then
		: > "${ERROR_FLAG}"
		if [ -z "${ERROR_LOG}" ] || [ ! -f "${ERROR_LOG}" ]
		then
			ERROR_SHELL=${BASHPID}
			ERROR_LOG=$(stdout_log "${ERROR_SHELL}")
			if [ -z "${ERROR_LOG}" ]
			then
				### The log of the package, when the failure is inside build
				# shellcheck disable=SC2153
				ERROR_LOG=${LOG_FILE}
			fi
		fi
		{
			echo
			echo "ERROR: ${ERROR_MSG:-command failed} [status ${STATUS}]"
			if [ -n "${PKG_FULLNAME}" ]
			then
				echo "   Package: ${PKG_FULLNAME}${PKG_TARGET:+:${PKG_TARGET}}"
			fi
			echo "   Stack:   ${FUNCNAME[*]:1}"
			if [ -n "${ERROR_LOG}" ] && [ -f "${ERROR_LOG}" ]
			then
				echo "   Log:     ${ERROR_LOG}"
				### stdout and stderr have a log writer each: the error lines (type !) are
				### not necessarily the last ones of the log, and some tools (meson, cmake)
				### explain the failure on stdout, so the end of both streams is shown
				if grep -q '^[-0-9]* [0-9:]* - \[[^]]*\]! ' "${ERROR_LOG}"
				then
					if grep -q '^[-0-9]* [0-9:]* - \[[^]]*\]- ' "${ERROR_LOG}"
					then
						echo "   Last $(( ${ERROR_LOG_LINES:-20} / 2 )) output lines of the log:"
						grep '^[-0-9]* [0-9:]* - \[[^]]*\]- ' "${ERROR_LOG}" | tail -n "$(( ${ERROR_LOG_LINES:-20} / 2 ))" | sed 's/^/   | /'
					fi
					echo "   Last ${ERROR_LOG_LINES:-20} error lines of the log:"
					grep '^[-0-9]* [0-9:]* - \[[^]]*\]! ' "${ERROR_LOG}" | tail -n "${ERROR_LOG_LINES:-20}" | sed 's/^/   | /'
				else
					echo "   Last ${ERROR_LOG_LINES:-20} lines of the log:"
					tail -n "${ERROR_LOG_LINES:-20}" "${ERROR_LOG}" | sed 's/^/   | /'
				fi
			fi
			echo
		} 2>&1 | error_console
		if [ -n "${ERROR_LOG}" ] && [ -f "${ERROR_LOG}" ]
		then
			echo "ERROR: ${ERROR_MSG:-command failed} [status ${STATUS}] [${FUNCNAME[*]:1}]" | log_buffer error "${ERROR_LOG}"
		fi
	fi
	if [ "${BASH_SUBSHELL}" -eq 0 ]
	then
		on_exit "${STATUS}"
	fi
	exit "${STATUS}"
}

on_interrupt () {
	### on_interrupt: the SIGINT trap of bbxb. Every shell of the process group gets the signal:
	### the subshells leave with 130, which on_error passes on silently, the main shell cleans up.
	set +E +o pipefail
	trap - ERR SIGINT
	if [ "${BASH_SUBSHELL}" -eq 0 ]
	then
		on_exit 130
	fi
	exit 130
}

on_exit () {
	### on_exit <status>: what the main shell does before leaving on an error or on SIGINT
	trap - ERR SIGINT
	{
		if [ "${1}" -eq 130 ]
		then
			echo
			echo "Interrupted."
		fi
		if declare -F unmount_tag > /dev/null
		then
			unmount_tag --all || true
		fi
		echo "Build stopped [status ${1}]."
		echo
	} 2>&1 | error_console
	rm -f "${TMPDIR:-/tmp}/bbxb_error.${$}"
	if [ -n "${BUILD_CHECKED_FILE}" ]
	then
		rm -f "${BUILD_CHECKED_FILE}"
	fi
	return 0
}

export -f run_cmd log_run log_wait log_buffer stdout_log

tab () {
	echo -en '\t'
}

is_core_functions () {
	return 0
}
