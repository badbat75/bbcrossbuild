#!/bin/bash

# GCC build
PACKAGES="bc parted e2fsprogs btrfs-progs bzip2-devel rsync vim-common gcc g++ binutils dwarves elfutils-libelf-devel patchelf libzstd libzstd-devel tree curl gawk git xmltoman docbook-utils swig texinfo python3-docutils"

# CLang build
PACKAGES+=" libedit-devel lua-devel ocaml-findlib ocaml-ctypes ocaml-ocamldoc"

# For Image emulation
PACKAGES+=" qemu-*-static qemu-kvm-tools qemu-kvm qemu-system-*"

# for autoconf runtime (the openssl 4 Makefile runs the perl of lfs/perl5:native)
PACKAGES+=" perl-FindBin perl-IPC-Cmd perl-Pod-Html"

# for Python3
PACKAGES+=" openssl-devel libffi-devel libuuid-devel tcl-devel"

# for moode
PACKAGES+=" sqlite"

# for wpa-supplicant
PACKAGES+=" docbook-utils-pdf"

# for libid3tag
PACKAGES+=" gperf"

# for lxml and the ical-glib-src-generator of lfs/libical:cross
PACKAGES+=" libxml2-devel"

# for the wayland documentation (dot)
PACKAGES+=" graphviz"

# for udevil
PACKAGES+=" intltool"

# for dlc-daemon
PACKAGES+=" pandoc"

# for systemd
PACKAGES+=" libxslt docbook-xsl docbook2X"

# for btrfs-progs
PACKAGES+=" asciidoc"

# for Tk 9, which packs its script library into a zip appended to the library (zipfs): its Makefile
# has no rule for the minizip configure falls back to without zip
PACKAGES+=" zip"

# for bbxb logtail, which follows the logs through inotify events
PACKAGES+=" inotify-tools"

if dnf > /dev/null 2>&1
then
    sudo dnf -y install ${PACKAGES}
else
    sudo yum -y install ${PACKAGES}
fi
