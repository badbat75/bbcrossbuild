#!/usr/bin/env python3
"""pkg2dir: one-off migration of BBCrossBuild recipes to one directory per package.

Modes (run them in this order):
  --move      git mv packages/<group>/<name>.pkg -> packages/<group>/<name>/package.sh
  --verify    cross-check the string scanner with bash: for every PKG_PREBUILD, PKG_POSTBUILD,
              PKG_BUILDSCRIPT and PKG_POSTINSTALL assignment found at the top level of a
              recipe, the extracted literal must evaluate to the value bash assigns when the
              recipe is sourced. Run it before --extract.
  --extract   move the top-level script strings into prebuild.sh / postbuild.sh / build.sh /
              postinstall.sh (un-escaped), delete them from package.sh, drop dead variables.
  --report    list the recipes that need manual work and why.
  --check     after --extract: every package.sh parses and no longer assigns the moved variables.

Options:
  --bbxb <dir>       framework root (default: the parent directory of this script)
  --platform <name>  platform used by the bash stub (default: generic-x64)
  <recipe dir>...    restrict --verify/--extract/--report/--check to these package directories

The un-escaping removes exactly one level of double-quote processing (\\\\ \\" \\` \\$ lose
their backslash, \\<newline> is kept as a line continuation, anything else is kept), so the
generated script is what the old runner contained, with the source-time ${VAR} references
kept symbolic: every ALL_CAPS variable is provided at run time by recipe.source.
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile

SCRIPT_VARS = {
    "PKG_PREBUILD": "prebuild.sh",
    "PKG_POSTBUILD": "postbuild.sh",
    "PKG_BUILDSCRIPT": "build.sh",
    "PKG_POSTINSTALL": "postinstall.sh",
}
SCRIPT_HEADERS = {
    "PKG_PREBUILD": "pre-build script, sourced by runprebuild.sh (cwd: ${PKG_SRCPATH}, set -x, no -e)",
    "PKG_POSTBUILD": "post-build script, sourced by runpostbuild.sh (cwd: ${PKG_BLDPATH}, set -ex)",
    "PKG_BUILDSCRIPT": "custom build script, sourced by runmake.sh (cwd: ${PKG_BLDPATH}[/${CONF_PATH}], bash -ex)",
    "PKG_POSTINSTALL": "post-install script, sourced as root inside the target chroot",
}
DEAD_VARS = [
    "INST_CMD", "PKG_DPES", "PKG_POST_BUILD", "CONF_ENVS", "PKG_SEPS",
    "PKG_TWOSTEPSBUILD", "PKG_SKIPINSTALL", "CONF_COPYRSC",
]
# Names exported by environment.source: a script that referenced them unescaped got the
# bbxb process value at source time, now it gets the build environment value.
ENV_OWNED = [
    "SYSROOT", "CC", "CXX", "CPP", "FC", "F90", "CFLAGS", "CXXFLAGS", "CPPFLAGS", "FFLAGS",
    "F90FLAGS", "LDFLAGS", "RUSTFLAGS", "AR", "AS", "NM", "RANLIB", "STRIP", "OBJCOPY",
    "OBJDUMP", "READELF", "LINKER_EXE", "PATH", "LD_LIBRARY_PATH", "PKG_CONFIG",
    "PKG_CONFIG_LIBDIR", "PKG_CONFIG_SYSROOT_DIR", "PKG_CONFIG_ALLOW_CROSS", "PYTHONPATH",
    "CARGO_HOME", "CARGO_TARGET", "RUSTUP_HOME", "QEMU_LD_PREFIX", "LC_ALL", "CONFIG_SITE",
]
# Plain (non exported) assignments written by environment.source: visible to the old runners too.
ENV_PLAIN = ["DISTOS_PATH", "BIN_PATH", "PKG_SRCPATH", "PKG_BLDPATH", "PKG_PKGPATH",
             "PLATFORM_CFLAGS", "OPTCOMP_FLAGS", "OPTLINK_FLAGS"]
RECIPE_FILENAME = "package.sh"

# An assignment at the start of a line, optionally behind a case arm label ("llvm) VAR=...")
ASSIGN_RE = re.compile(r"^(?P<indent>[ \t]*)(?P<arm>[A-Za-z0-9_|*?.-]+\)[ \t]+)?(?P<name>[A-Z_][A-Z0-9_]*)(?P<op>\+?=)")
WORD_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
OPEN_RE = re.compile(r"(?<![\w$@{-])(?:case|if|for|while|until)(?![\w-])")
CLOSE_RE = re.compile(r"(?<![\w$@{-])(?:esac|fi|done)(?![\w-])")
QUOTED_RE = re.compile(r'"[^"]*"|\'[^\']*\'')
COMMENT_RE = re.compile(r"(^|\s)#.*$")
TAB_HACK_RE = re.compile(r'\$\(echo -e "\\\\?t"\)')


def depth_delta(line):
    """Net number of control-flow blocks opened by a line of recipe code (crude but adequate:
    single-line quoted strings and comments are ignored first)."""
    code = COMMENT_RE.sub("", QUOTED_RE.sub('""', line))
    return len(OPEN_RE.findall(code)) - len(CLOSE_RE.findall(code))


class ScanError(Exception):
    pass


def scan_word(text, i):
    """Scan the shell word starting at text[i].

    Returns (end, unescaped, segments) where end is the index just past the word, unescaped
    is the value with one level of quoting removed and segments lists ('DQ'|'SQ'|'RAW', ...).
    Content inside $( ), backticks and nested quotes is copied verbatim, as bash does.
    """
    n = len(text)
    out = []
    segments = []
    stack = []
    j = i
    while j < n:
        c = text[j]
        top = stack[-1][0] if stack else None
        if top is None:
            if c == '"':
                stack.append(["DQ"])
                segments.append("DQ")
                j += 1
                continue
            if c == "'":
                stack.append(["SQ", True])
                segments.append("SQ")
                j += 1
                continue
            if c in " \t\n;":
                return j, "".join(out), segments
            if c == "\\" and j + 1 < n:
                out.append(text[j + 1])
                segments.append("RAW")
                j += 2
                continue
            out.append(c)
            segments.append("RAW")
            j += 1
            continue
        if top == "SQ":
            if c == "'":
                stack.pop()
            else:
                out.append(c)
            j += 1
            continue
        if top == "DQ":
            if c == "\\" and j + 1 < n:
                nxt = text[j + 1]
                if nxt in '\\"$`':
                    out.append(nxt)
                else:
                    out.append(c)
                    out.append(nxt)
                j += 2
                continue
            if c == '"':
                stack.pop()
                j += 1
                continue
            if c == "$" and text[j + 1:j + 2] == "(":
                stack.append(["CS", 0, 0])
                out.append("$(")
                j += 2
                continue
            if c == "`":
                stack.append(["BT"])
                out.append(c)
                j += 1
                continue
            out.append(c)
            j += 1
            continue
        # Inside a command substitution, a backtick or a quote nested in one of them:
        # everything is copied verbatim, only the structure is tracked.
        out.append(c)
        if top == "BT":
            if c == "\\" and j + 1 < n:
                out.append(text[j + 1])
                j += 2
                continue
            if c == "`":
                stack.pop()
            j += 1
            continue
        if top == "IDQ":
            if c == "\\" and j + 1 < n:
                out.append(text[j + 1])
                j += 2
                continue
            if c == '"':
                stack.pop()
            elif c == "$" and text[j + 1:j + 2] == "(":
                out.append("(")
                stack.append(["CS", 0, 0])
                j += 1
            elif c == "`":
                stack.append(["BT"])
            j += 1
            continue
        if top == "ISQ":
            if c == "'":
                stack.pop()
            j += 1
            continue
        # top == "CS"
        entry = stack[-1]
        if c == "\\" and j + 1 < n:
            out.append(text[j + 1])
            j += 2
            continue
        if c == '"':
            stack.append(["IDQ"])
            j += 1
            continue
        if c == "'":
            stack.append(["ISQ"])
            j += 1
            continue
        if c == "`":
            stack.append(["BT"])
            j += 1
            continue
        if c == "$" and text[j + 1:j + 2] == "(":
            out.append("(")
            stack.append(["CS", 0, 0])
            j += 2
            continue
        if c == "(":
            entry[1] += 1
            j += 1
            continue
        if c == ")":
            if entry[1] > 0:
                entry[1] -= 1
            elif entry[2] > 0:
                pass  # pattern terminator of a case arm
            else:
                stack.pop()
            j += 1
            continue
        if c.isalpha() or c == "_":
            m = WORD_RE.match(text, j)
            word = m.group(0)
            prev = text[j - 1] if j > 0 else " "
            if prev in " \t\n;(":
                if word == "case":
                    entry[2] += 1
                elif word == "esac" and entry[2] > 0:
                    entry[2] -= 1
            out.append(word[1:])
            j = m.end()
            continue
        j += 1
    if stack:
        raise ScanError("unterminated quoted value")
    return j, "".join(out), segments


class Assignment:
    def __init__(self, name, op, start, end, line_no, depth, raw, value, segments, tail):
        self.name = name
        self.op = op
        self.start = start        # offset of the line start
        self.end = end            # offset just past the closing newline (or EOF)
        self.line_no = line_no
        self.depth = depth
        self.raw = raw            # literal as written, quotes included
        self.value = value        # one level of quoting removed
        self.segments = segments
        self.tail = tail          # what follows the value on its last line


def parse_recipe(text, names):
    """Find every assignment of the given variables, with its control-flow depth.

    Returns (assignments, suspicious) where suspicious lists (line_no, line) for lines that
    mention one of the variables in a position the scanner does not handle.
    """
    found = []
    suspicious = []
    pos = 0
    depth = 0
    line_no = 0
    n = len(text)
    mention_re = re.compile(r"\b(?:%s)\+?=" % "|".join(sorted(names)))
    while pos < n:
        eol = text.find("\n", pos)
        if eol < 0:
            eol = n
        line = text[pos:eol]
        line_no += 1
        m = ASSIGN_RE.match(line)
        if m and m.group("name") in names:
            vstart = pos + m.end()
            try:
                vend, value, segments = scan_word(text, vstart)
            except ScanError as exc:
                raise ScanError("%s at line %d: %s" % (m.group("name"), line_no, exc))
            raw = text[vstart:vend]
            teol = text.find("\n", vend)
            if teol < 0:
                teol = n
            tail = text[vend:teol]
            arm_depth = depth + (1 if m.group("arm") else 0)
            found.append(Assignment(m.group("name"), m.group("op"), pos, min(teol + 1, n),
                                    line_no, arm_depth, raw, value, segments, tail))
            line_no += raw.count("\n")
            pos = min(teol + 1, n)
            continue
        if mention_re.search(COMMENT_RE.sub("", line)):
            suspicious.append((line_no, line.strip()))
        depth += depth_delta(line)
        pos = eol + 1
    return found, suspicious


def unescape_single_quoted(value):
    return TAB_HACK_RE.sub("\t", value)


def script_text(assignments):
    """Concatenate the values of a top-level = / += chain into the script body."""
    body = ""
    for a in assignments:
        v = a.value
        if a.segments == ["SQ"]:
            v = unescape_single_quoted(v)
        body += v
    body = body.strip("\n")
    body = "\n".join(line.rstrip() if line.strip() == "" else line for line in body.split("\n"))
    return body.rstrip() + "\n"


def analyse(recipe_path, text):
    """Return (chains, issues) for one recipe.

    chains: {var: [Assignment...]} for the variables that can be converted mechanically.
    issues: list of strings describing what needs manual work.
    """
    issues = []
    try:
        found, suspicious = parse_recipe(text, set(SCRIPT_VARS) | set(DEAD_VARS))
    except ScanError as exc:
        return {}, ["scanner: %s" % exc]
    for line_no, line in suspicious:
        issues.append("line %d assigns a script variable in an unsupported position: %s" % (line_no, line[:60]))
    chains = {}
    for a in found:
        if a.name in DEAD_VARS:
            continue
        if a.depth > 0:
            issues.append("%s%s at line %d is nested in case/if/for (depth %d): move the control flow into %s"
                          % (a.name, a.op, a.line_no, a.depth, SCRIPT_VARS[a.name]))
            chains.pop(a.name, None)
            chains.setdefault("__blocked__" + a.name, True)
            continue
        if "__blocked__" + a.name in chains:
            issues.append("%s%s at line %d follows a nested assignment: convert by hand" % (a.name, a.op, a.line_no))
            continue
        if a.tail.strip() and not a.tail.strip().startswith("#"):
            issues.append("%s at line %d has trailing code on the closing line (%r)" % (a.name, a.line_no, a.tail.strip()))
            chains.pop(a.name, None)
            chains["__blocked__" + a.name] = True
            continue
        if a.op == "=":
            chains[a.name] = [a]
        else:
            if a.name not in chains:
                issues.append("%s+= at line %d has no previous top-level assignment" % (a.name, a.line_no))
                chains["__blocked__" + a.name] = True
                continue
            chains[a.name].append(a)
    chains = {k: v for k, v in chains.items() if not k.startswith("__blocked__")}
    for name, chain in chains.items():
        for a in chain:
            if a.segments and a.segments != ["DQ"] and a.segments != ["SQ"]:
                issues.append("%s at line %d mixes quoting styles (%s): convert by hand" % (name, a.line_no, "+".join(a.segments)))
            if a.segments == ["SQ"]:
                issues.append("%s at line %d is single-quoted: review the script, patch4package tab hack reverted" % (name, a.line_no))
            if a.segments == ["DQ"]:
                inner = a.raw[1:-1]
                if re.search(r"(?<!\\)\$\(", inner) or re.search(r"(?<!\\)`", inner):
                    issues.append("%s at line %d contains an unescaped $( ) or backtick: it ran at source time, now it runs at build time" % (name, a.line_no))
                for env in ENV_OWNED:
                    if re.search(r"(?<!\\)\$\{?%s\b" % env, inner):
                        issues.append("%s at line %d references ${%s} unescaped: it now takes the build environment value" % (name, a.line_no, env))
                if "PATCH_PATH" in inner:
                    issues.append("%s at line %d references PATCH_PATH: patches now live in the recipe directory" % (name, a.line_no))
    return chains, issues


