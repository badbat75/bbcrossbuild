def run_stub(bbxb, platform, recipe, action_text, target="", toolchain="gnu"):
    with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as stub, \
            tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as action:
        stub.write(STUB)
        action.write(action_text)
        stub_name, action_name = stub.name, action.name
    try:
        proc = subprocess.run(["bash", stub_name, bbxb, platform, recipe, target, toolchain, action_name],
                              capture_output=True, text=True)
    finally:
        os.unlink(stub_name)
        os.unlink(action_name)
    return proc.returncode, proc.stdout, proc.stderr


def recipe_dirs(bbxb, selected):
    pkg_root = os.path.join(bbxb, "packages")
    if selected:
        dirs = [os.path.abspath(d) for d in selected]
    else:
        dirs = []
        for group in sorted(os.listdir(pkg_root)):
            gpath = os.path.join(pkg_root, group)
            if not os.path.isdir(gpath):
                continue
            if os.path.isfile(os.path.join(gpath, RECIPE_FILENAME)):
                dirs.append(gpath)  # packages/template
                continue
            for name in sorted(os.listdir(gpath)):
                d = os.path.join(gpath, name)
                if os.path.isfile(os.path.join(d, RECIPE_FILENAME)):
                    dirs.append(d)
    return dirs


def relname(bbxb, path):
    return os.path.relpath(path, bbxb)


def do_move(bbxb):
    pkg_root = os.path.join(bbxb, "packages")
    moves = []
    for root, _dirs, files in os.walk(pkg_root):
        for f in files:
            if f.endswith(".pkg"):
                src = os.path.join(root, f)
                dst = os.path.join(root, f[:-4], RECIPE_FILENAME)
                moves.append((src, dst))
    for src, dst in sorted(moves):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        subprocess.run(["git", "-C", bbxb, "mv", relname(bbxb, src), relname(bbxb, dst)], check=True)
    print("moved %d recipes" % len(moves))


def do_verify(bbxb, platform, dirs):
    bad = 0
    for d in dirs:
        recipe = os.path.join(d, RECIPE_FILENAME)
        with open(recipe, encoding="utf-8") as fh:
            text = fh.read()
        chains, _issues = analyse(recipe, text)
        for name, chain in chains.items():
            action = "OLD=${%s}\nNEW=\n" % name
            deferred = set()
            for a in chain:
                action += "NEW+=%s\n" % a.raw
                if a.segments == ["DQ"]:
                    # \${NAME} was expanded by the old runner, i.e. empty unless exported;
                    # with recipe.source it now takes the recipe-time value.
                    for v in re.findall(r"\\\$\{?([A-Z_][A-Z0-9_]*)", a.raw[1:-1]):
                        if v not in ENV_OWNED and v not in ENV_PLAIN:
                            deferred.add(v)
            action += ('if [ "${OLD}" == "${NEW}" ]; then echo VERIFY-OK; else echo VERIFY-MISMATCH; '
                       'printf "%s" "${OLD}" > /tmp/pkg2dir-old.txt; printf "%s" "${NEW}" > /tmp/pkg2dir-new.txt; fi\n')
            if deferred:
                # session variables are never written to recipe.source, skip them here too
                action += ('for V in %s; do case ${V} in HOME|USER|USERNAME|LOGNAME|LANG|LC_*|TERM|DISPLAY|XDG_*|DBUS_*|SSH_*|SUDO_*) continue;; esac; '
                           'D=$(declare -p "${V}" 2>/dev/null) || continue; '
                           'case ${D%%%% *} in *x*) ;; *) echo "NOW-RESOLVES ${V}";; esac; done\n'
                           % " ".join(sorted(deferred)))
            rc, out, err = run_stub(bbxb, platform, recipe, action)
            for line in out.splitlines():
                if line.startswith("NOW-RESOLVES"):
                    print("NOTE     %s %s: %s was empty at build time, now it resolves"
                          % (relname(bbxb, recipe), name, line.split()[1]))
            if "VERIFY-OK" not in out:
                bad += 1
                print("MISMATCH %s %s (rc=%d)" % (relname(bbxb, recipe), name, rc))
                if err.strip():
                    print("  stderr: " + err.strip().splitlines()[-1])
                if "VERIFY-MISMATCH" in out:
                    diff = subprocess.run(["diff", "/tmp/pkg2dir-old.txt", "/tmp/pkg2dir-new.txt"],
                                          capture_output=True, text=True).stdout
                    print("  " + "\n  ".join(diff.splitlines()[:12]))
            else:
                print("ok       %s %s (%d fragment%s)" % (relname(bbxb, recipe), name, len(chain), "s" if len(chain) > 1 else ""))
    print("verify: %d mismatch(es)" % bad)
    return bad == 0


def do_extract(bbxb, dirs):
    converted = 0
    for d in dirs:
        recipe = os.path.join(d, RECIPE_FILENAME)
        with open(recipe, encoding="utf-8") as fh:
            text = fh.read()
        chains, _issues = analyse(recipe, text)
        try:
            found, _suspicious = parse_recipe(text, set(SCRIPT_VARS) | set(DEAD_VARS))
        except ScanError as exc:
            print("SKIP %s: %s" % (relname(bbxb, recipe), exc))
            continue
        to_delete = []
        for name, chain in chains.items():
            body = script_text(chain)
            if body.strip() == "":
                to_delete.extend(chain)
                continue
            pkgname = os.path.basename(d)
            header = ("# shellcheck shell=bash\n"
                      "# shellcheck disable=SC2154\n"
                      "# %s: %s.\n"
                      "# Every ALL_CAPS variable visible to package.sh is available here as ${VAR}.\n\n"
                      % (pkgname, SCRIPT_HEADERS[name]))
            target = os.path.join(d, SCRIPT_VARS[name])
            with open(target, "w", encoding="utf-8") as fh:
                fh.write(header + body)
            to_delete.extend(chain)
            converted += 1
        for a in found:
            if a.name in DEAD_VARS and a.depth == 0 and not (a.tail.strip() and not a.tail.strip().startswith("#")):
                to_delete.append(a)
        if not to_delete:
            continue
        # delete whole assignment lines, from the end so offsets stay valid
        new_text = text
        for a in sorted(to_delete, key=lambda x: x.start, reverse=True):
            new_text = new_text[:a.start] + new_text[a.end:]
        new_text = re.sub(r"\n{3,}", "\n\n", new_text)
        if not new_text.endswith("\n"):
            new_text += "\n"
        with open(recipe, "w", encoding="utf-8") as fh:
            fh.write(new_text)
    print("extracted %d script(s)" % converted)


def do_report(bbxb, dirs):
    total = 0
    for d in dirs:
        recipe = os.path.join(d, RECIPE_FILENAME)
        with open(recipe, encoding="utf-8") as fh:
            text = fh.read()
        _chains, issues = analyse(recipe, text)
        if issues:
            total += 1
            print(relname(bbxb, recipe))
            for i in issues:
                print("  - " + i)
    print("report: %d recipe(s) need manual work" % total)


def do_check(bbxb, platform, dirs):
    bad = 0
    action = ("for V in %s; do if [ -n \"${!V}\" ]; then echo \"STILL-SET ${V}\"; fi; done\n"
              % " ".join(list(SCRIPT_VARS) + DEAD_VARS))
    for d in dirs:
        recipe = os.path.join(d, RECIPE_FILENAME)
        syntax = subprocess.run(["bash", "-n", recipe], capture_output=True, text=True)
        if syntax.returncode != 0:
            bad += 1
            print("SYNTAX %s: %s" % (relname(bbxb, recipe), syntax.stderr.strip()))
            continue
        for script in SCRIPT_VARS.values():
            path = os.path.join(d, script)
            if os.path.isfile(path):
                syntax = subprocess.run(["bash", "-n", path], capture_output=True, text=True)
                if syntax.returncode != 0:
                    bad += 1
                    print("SYNTAX %s: %s" % (relname(bbxb, path), syntax.stderr.strip()))
        for target in ("", "native", "cross"):
            _rc, out, _err = run_stub(bbxb, platform, recipe, action, target=target)
            for line in out.splitlines():
                if line.startswith("STILL-SET"):
                    bad += 1
                    print("%s [%s]: %s" % (relname(bbxb, recipe), target or "target", line))
    print("check: %d problem(s)" % bad)
    return bad == 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--bbxb", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    parser.add_argument("--platform", default="generic-x64")
    mode = parser.add_mutually_exclusive_group(required=True)
    for m in ("move", "verify", "extract", "report", "check"):
        mode.add_argument("--" + m, action="store_true")
    parser.add_argument("dirs", nargs="*")
    args = parser.parse_args()
    bbxb = os.path.abspath(args.bbxb)
    if args.move:
        do_move(bbxb)
        return 0
    dirs = recipe_dirs(bbxb, args.dirs)
    if args.verify:
        return 0 if do_verify(bbxb, args.platform, dirs) else 1
    if args.extract:
        do_extract(bbxb, dirs)
        return 0
    if args.report:
        do_report(bbxb, dirs)
        return 0
    if args.check:
        return 0 if do_check(bbxb, args.platform, dirs) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
