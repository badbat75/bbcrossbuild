#!/bin/bash

### The packages of the Dockerfile: every tool a package build runs and every library the programs of
### the build machine link is built by the framework (lfs/*:native), the host gives the compiler,
### what bbxb runs before any package is built, the image and emulation tools

# Compiler and base tools
sudo apt-get install -y rsync util-linux fdisk \
    build-essential dwarves patchelf file curl gawk patch git \
    zip unzip debianutils

# For Image emulation
sudo apt-get install -y qemu-user-static

# for bbxb logtail, which follows the logs through inotify events
sudo apt-get install -y inotify-tools
