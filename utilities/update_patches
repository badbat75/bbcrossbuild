#!/bin/bash -e
# update_patches <package> <ver1> [<ver2..n>]: regenerate the release branch patch of gcc,
# binutils, glibc or gdb for the given versions. For every version it writes
# packages/lfs/<package>/variants/version/<ver>/patches/00-<package>_<ver>+<sha>.patch, replacing
# the patch of a previous branch head; the version variant selects it when PKG_VER matches and
# toolchain.functions applies the same directory to the toolchain sources. Other patches of the
# variant (the 10-glibc-<ver>-fhs-1.patch of glibc) are kept.

url4pkg () {
	case ${PACKAGE} in
		glibc) echo "https://sourceware.org/git/glibc.git" ;;
		gcc) echo "https://sourceware.org/git/gcc.git" ;;
		binutils) echo "https://sourceware.org/git/binutils-gdb.git" ;;
		gdb) echo "https://sourceware.org/git/binutils-gdb.git" ;;
	esac
}

gitrepo4pkg () {
	case ${PACKAGE} in
		glibc) echo "glibc" ;;
		gcc) echo "gcc" ;;
		binutils) echo "binutils-gdb" ;;
		gdb) echo "binutils-gdb" ;;
	esac
}

gitrepo_additional_params () {
	case ${PACKAGE} in
		binutils) echo "-- . "':!libbacktrace/'" "':!gas/doc/.dirstamp';;
	esac
}

rel4pkg () {
	case ${PACKAGE} in
		glibc) echo "refs/tags/glibc-${PKG_VER}" ;;
		gcc) echo "refs/tags/releases/gcc-${PKG_VER}" ;;
		binutils) echo "refs/tags/binutils-${PKG_USCOREVER}";;
		gdb) echo "refs/tags/gdb-${PKG_VER}-release";;
	esac
}

head4pkg () {
	case ${PACKAGE} in
		glibc) echo "origin/release/${PKG_VER}/master" ;;
		gcc) echo "origin/releases/gcc-${PKG_MAJVER}" ;;
		binutils) echo "origin/binutils-${PKG_USCOREVER}-branch" ;;
		gdb) echo "origin/gdb-${PKG_MAJVER}-branch" ;;
	esac
}

generate_patch () {
	### generate_patch: write the patch into the version variant of the recipe, replacing the
	### one of a previous branch head
	local LAST_COMMIT PATCH_FILE PATCHES_PATH
	LAST_COMMIT=$(git -C "/tmp/$(gitrepo4pkg)" rev-parse --short -1 "$(head4pkg)")
	PATCH_FILE="00-${PACKAGE}_${PKG_VER}+${LAST_COMMIT}.patch"
	PATCHES_PATH="${RECIPE_PATH}/variants/version/${PKG_VER}/patches"
	git -C "/tmp/$(gitrepo4pkg)" branch -m "$(head4pkg)"
	mkdir -p "${PATCHES_PATH}"
	rm -f "${PATCHES_PATH}/00-${PACKAGE}_${PKG_VER}+"*.patch
	# shellcheck disable=SC2046
	git -C "/tmp/$(gitrepo4pkg)" diff "$(rel4pkg)..${LAST_COMMIT}" $(gitrepo_additional_params) > "${PATCHES_PATH}/${PATCH_FILE}"
	echo -n "${PATCH_FILE} "
}

BBXB_PATH=$(realpath "$(dirname "${0}")/..")
echo "bbxbuild path: ${BBXB_PATH}"
PACKAGE=${1}
shift
VERSIONS=${*}

if [ -z "${VERSIONS}" ] || [ -z "${PACKAGE}" ]
then
	echo "No package and versions has been specified"
	echo
	echo "Usage:"
	echo
	echo "$(basename "${0}") <package> <ver1> [<ver2..n>]"
	echo
	exit 1
fi

case ${PACKAGE} in
	gcc|binutils|glibc|gdb)
	;;
	*)
		echo "Only gcc, binutils, glibc and gdb are supported."
		echo
		exit 1
	;;
esac

if [ ! -d "/tmp/$(gitrepo4pkg)" ]
then
	mkdir "/tmp/$(gitrepo4pkg)"
	git -C "/tmp/$(gitrepo4pkg)" init
	git -C "/tmp/$(gitrepo4pkg)" remote add origin "$(url4pkg)"
fi
git -C "/tmp/$(gitrepo4pkg)" fetch

RECIPE_PATH="${BBXB_PATH}/packages/lfs/${PACKAGE}"
for PKG_VER in ${VERSIONS}
do
	PKG_MAJVER=$(echo "${PKG_VER}" | cut -d'.' -f1)
	PKG_USCOREVER=${PKG_VER//./_}
	echo -n "Generating patch for ${PACKAGE}_${PKG_VER}... "
	generate_patch
	echo "done."
done
